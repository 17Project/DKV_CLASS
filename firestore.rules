rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 200;
      allow delete: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /adminAuth/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
